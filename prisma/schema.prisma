// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../application/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  name  String?

  quinielaUsers QuinielaUser[]
} 
model League { 
  id      Int     @id @default(autoincrement()) 
  name    String
  year    Int  
  status  Boolean

  jornadas  Jornada[]  // una liga tiene muchas jornadas

  teams Team[]

  quinielas Quiniela[]
} 

model Jornada {
  id        Int     @id @default(autoincrement()) 
  name      String  // jornada 1, cuartos de final ida, final ida
  status    Boolean

  leagueId  Int
  league    League  @relation(fields: [leagueId], references: [id])
  @@unique([leagueId, name])

  matches Match[]
}

model Match {
  id           Int   @id @default(autoincrement())

  jornadaId    Int
  jornadas      Jornada @relation(fields: [jornadaId], references: [id])

  homeTeamId   Int
  awayTeamId   Int

  homeTeam     Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team @relation("AwayTeam", fields: [awayTeamId], references: [id])

  betDeadline DateTime // Ultima hora para llenar quiniela
  matchDate    DateTime

  homeScore    Int?
  awayScore    Int?

  hadRedCard Boolean?

  predictions Prediction[]

  pointsLogs PointsLog[]
}

model Team {
  id     Int     @id @default(autoincrement())
  name   String

  // Relaciones inversas
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  leagueId  Int
  league    League  @relation(fields: [leagueId], references: [id])

  @@unique([name, leagueId])
}

model Quiniela {
  id          Int      @id @default(autoincrement())
  name        String
  description String?

  leagueId    Int
  league      League   @relation(fields: [leagueId], references: [id])

  startDate   DateTime
  endDate     DateTime

  inviteCode  String   @unique
  isPrivate   Boolean  @default(false)

  createdAt   DateTime @default(now())

  users       QuinielaUser[]

  quinielaRules QuinielaRule[]
}

enum QuinielaRole {
  ADMIN
  USER
}

enum QuinielaUserStatus {
  ACTIVE
  REMOVED
}

model QuinielaUser {
  id           Int      @id @default(autoincrement())

  userId       Int
  quinielaId   Int

  user         User     @relation(fields: [userId], references: [id])
  quiniela     Quiniela @relation(fields: [quinielaId], references: [id])

  totalPoints  Int      @default(0)

  role         QuinielaRole @default(USER)
  status       QuinielaUserStatus @default(ACTIVE)

  createdAt    DateTime @default(now())

  predictions  Prediction[]

  @@unique([userId, quinielaId])
  pointsLogs PointsLog[]
}

model Prediction {
  id               Int      @id @default(autoincrement())

  quinielaUserId   Int
  matchId          Int

  quinielaUser     QuinielaUser @relation(fields: [quinielaUserId], references: [id])
  match            Match        @relation(fields: [matchId], references: [id])

  predictedHome    Int
  predictedAway    Int

  predictedRedCard Boolean?

  pointsEarned     Int      @default(0)

  createdAt        DateTime @default(now())

  @@unique([quinielaUserId, matchId])
}

model PointsLog {
  id               Int      @id @default(autoincrement())

  quinielaUserId   Int
  matchId          Int?

  quinielaUser     QuinielaUser @relation(fields: [quinielaUserId], references: [id])
  match            Match?       @relation(fields: [matchId], references: [id])

  points           Int
  reason           String

  createdAt        DateTime @default(now())
}

model QuinielaRule {
  id          Int      @id @default(autoincrement())

  quinielaId  Int
  quiniela    Quiniela @relation(fields: [quinielaId], references: [id])

  type        RuleType
  points      Int

  createdAt   DateTime @default(now())
}

enum RuleType {
  EXACT_SCORE
  WINNER
  RED_CARD
}